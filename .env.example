# 复制为 .env 后填写。.env 已在 .gitignore 中。

# ---- 老师 / 评委 / 用户模拟器：DeepSeek（OpenAI 兼容接口）----
DEEPSEEK_API_KEY=
TEACHER_BASE_URL=https://api.deepseek.com
TEACHER_MODEL=deepseek-v4-pro
# 评委和用户模拟器默认用更便宜的 flash
JUDGE_MODEL=deepseek-flash
USERSIM_MODEL=deepseek-flash

# ---- 学生：训练后用 vLLM 部署的模型（OpenAI 兼容接口）----
STUDENT_BASE_URL=http://localhost:8000/v1
STUDENT_API_KEY=EMPTY
STUDENT_MODEL=meme6657
